<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulsRig" Width="1108" Height="728"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Farben -->
        <SolidColorBrush x:Key="Text" Color="#E8EEFC"/>
        <SolidColorBrush x:Key="TextDim" Color="#93A3C7"/>
        <SolidColorBrush x:Key="TextFaint" Color="#5E6E93"/>
        <SolidColorBrush x:Key="Panel" Color="#131C33"/>
        <SolidColorBrush x:Key="Stroke" Color="#223052"/>
        <SolidColorBrush x:Key="Accent" Color="#22D3EE"/>
        <SolidColorBrush x:Key="Good" Color="#34D399"/>
        <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Bad" Color="#FB7185"/>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="0.55"/>
            <GradientStop Color="#A855F7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glasoptik: heller Schimmer von links oben, feine Lichtkante am oberen Rand -->
        <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#21FFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
            <GradientStop Color="#11FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.14"/>
            <GradientStop Color="#17FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Karte -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <!-- Auswahlknopf (Ring-Animation): Tag="on" hebt den gewählten hervor -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Back" CornerRadius="8" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                            <Border x:Name="On" CornerRadius="8" Background="{StaticResource RingGrad}" Opacity="0"/>
                            <Border x:Name="OnEdge" CornerRadius="8" BorderBrush="{StaticResource Ring1}" BorderThickness="1" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="On" Property="Opacity" Value="0.22"/>
                                <Setter TargetName="OnEdge" Property="Opacity" Value="0.75"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hauptknopf mit Farbverlauf: leuchtet beim Überfahren, gibt beim Drücken nach -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="13" Margin="-2" Background="{StaticResource AccentGrad}" Opacity="0">
                                <Border.Effect>
                                    <BlurEffect Radius="14"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="11" Background="{StaticResource AccentGrad}"/>
                            <Border x:Name="Shine" CornerRadius="11" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zurückhaltender Knopf -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border CornerRadius="11" Background="#151F38" BorderBrush="#2A3A63" BorderThickness="1"/>
                            <Border x:Name="Hover" CornerRadius="11" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fensterknöpfe oben rechts -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="8" Background="White" Opacity="0"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- unter der Maus blendet die Fläche weich ein und das Zeichen wächst ein wenig -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.26"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.26"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schließen-Knopf des Fensters: wird beim Überfahren rot, wie in Windows -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="8" Background="#E5484D" Opacity="0"/>
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <RotateTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- unter der Maus blendet das Rot weich ein und das Kreuz dreht sich eine Vierteldrehung -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Werkzeug-Kachel: hebt sich beim Überfahren an und bekommt einen farbigen Rand -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="184"/>
            <Setter Property="Height" Value="146"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Grid.RenderTransform>
                                <TranslateTransform/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="16" Background="{StaticResource Glass}"/>
                            <Border x:Name="Hover" CornerRadius="15" Margin="1" Background="White" Opacity="0"/>
                            <Border x:Name="Rim" CornerRadius="16" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1"/>
                            <Border x:Name="Edge" CornerRadius="16" BorderBrush="{StaticResource AccentGrad}" BorderThickness="1.2" Opacity="0"/>
                            <ContentPresenter Margin="14,15"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- gedrückt: die Kachel gibt sichtbar nach -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.035" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schmale Bildlaufleiste -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#2E4070"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auswahlkästchen: der Haken blendet weich ein -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="22" Height="22" Background="Transparent">
                            <Border CornerRadius="7" Background="#0E162D" BorderBrush="#33466F" BorderThickness="1.5"/>
                            <Border x:Name="Fill" CornerRadius="7" Background="{StaticResource AccentGrad}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                </Border.RenderTransform>
                            </Border>
                            <Path x:Name="Mark" Data="M 6,11.5 L 9.6,15 L 16,7.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8 8" StrokeDashOffset="8" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- angekreuzt: die Füllung springt auf, der Haken zeichnet sich von links nach rechts -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.8"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.5" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.5" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" To="8" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eingabefeld -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Background="#0C1326" BorderBrush="#2A3A63" BorderThickness="1" Padding="10,7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schalter: der Knopf gleitet mit leichtem Überschwingen auf die andere Seite -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border CornerRadius="13" Background="#0E162D" BorderBrush="#33466F" BorderThickness="1.5"/>
                            <Border x:Name="Fill" CornerRadius="13" Background="{StaticResource AccentGrad}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unterstrichener Textknopf -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,3">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reiter: die farbige Marke dahinter gleitet per Code zum gewählten Reiter -->
        <Style x:Key="PillTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zeile im Seitenmenü: Symbol (aus Tag) in einer Kachel, rechts ein Pfeil -->
        <Style x:Key="DrawerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="12" Background="White" Opacity="0"/>
                            <Grid Margin="8,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="#2422D3EE"/>
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eintrag im Aufklappmenü einer Ergebniszeile: Symbol (aus Tag) in einer Kachel; BorderBrush gibt dessen Farbe vor -->
        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="White" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="7,0,16,0">
                                <Grid x:Name="Icon" Width="30" Height="30" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform/>
                                    </Grid.RenderTransform>
                                    <Border CornerRadius="9" Background="{TemplateBinding BorderBrush}" Opacity="0.16"/>
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{TemplateBinding BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter x:Name="Label" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- unter der Maus: Fläche blendet ein, das Symbol wächst, der Text rückt nach rechts -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menüzeile: das Symbol steht in Tag -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="White" Opacity="0"/>
                            <StackPanel x:Name="Line" Orientation="Horizontal" Margin="12,9,16,9">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="30" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="4" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liste im großen Dialog: nur sichtbare Zeilen werden aufgebaut -->
        <Style x:Key="SheetListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <ItemsPresenter Margin="0,0,10,0"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SheetItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Opacity="0" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="12" Background="White" Opacity="0" Margin="12,3"/>
                            <ContentPresenter Margin="12,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.04"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eine Listenzeile: Überschrift (head), Schlüssel und Wert (pair) oder Zeile mit Auswahl, Balken und Aktion -->
        <DataTemplate x:Key="SheetRow">
            <Grid>
                <StackPanel x:Name="Head" Orientation="Horizontal" Margin="0,14,0,7" Visibility="Collapsed">
                    <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AccentGrad}" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Schlüssel und Wert: feine Linie darunter, damit die Zeilen als Tabelle lesbar sind -->
                <Border x:Name="Pair" Visibility="Collapsed" Padding="10,9,6,9" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Grid x:Name="Row" Margin="0,3">
                    <!-- jede Zeile ist eine Karte; ausgewählte bekommen die Akzentfarbe -->
                    <Border CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"/>
                    <Border x:Name="RowOn" CornerRadius="12" Background="#1422D3EE" BorderBrush="#5922D3EE" BorderThickness="1" Opacity="0"/>
                    <Grid Margin="12,9,14,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="Box" Style="{StaticResource Check}" IsChecked="{Binding Checked, Mode=OneWay}" Visibility="{Binding CheckVis}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Grid Width="32" Height="32" Margin="0,0,12,0" Visibility="{Binding GlyphVis}">
                            <Border CornerRadius="10" Background="#14FFFFFF"/>
                            <TextBlock x:Name="RowGlyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding SubVis}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="64" TextAlignment="Right"/>
                    <Grid Grid.Column="3" Width="130" Height="6" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding BarVis}">
                        <Border CornerRadius="3" Background="#14FFFFFF"/>
                        <Border x:Name="RowBar" CornerRadius="3" Background="{StaticResource AccentGrad}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Bar}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border CornerRadius="8" Padding="9,3" Background="#14FFFFFF" Visibility="{Binding StateVis}" VerticalAlignment="Center">
                            <TextBlock x:Name="State" Text="{Binding State}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                        </Border>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding Action}" Visibility="{Binding ActionVis}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Box" Property="IsChecked" Value="True">
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding Kind}" Value="head">
                    <Setter TargetName="Head" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="pair">
                    <Setter TargetName="Pair" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="good">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Good}"/>
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{StaticResource Good}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Warn}"/>
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{StaticResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="bad">
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Bad}"/>
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{StaticResource Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="accent">
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Der Rand lässt Platz für den Schatten des Fensters -->
    <Grid Margin="14">
        <Border CornerRadius="18" Background="#0A0F1E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Shell" CornerRadius="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0C1326" Offset="0"/>
                    <GradientStop Color="#090D1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Farbschein des Designs: oben links die erste, unten rechts die dritte Akzentfarbe -->
                <Ellipse x:Name="GlowA" Grid.ColumnSpan="2" Grid.RowSpan="2" Width="1000" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-420,-330,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2A22D3EE" Offset="0"/>
                            <GradientStop Color="#0022D3EE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="GlowB" Grid.ColumnSpan="2" Grid.RowSpan="2" Width="1100" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-480,-400" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2EA855F7" Offset="0"/>
                            <GradientStop Color="#00A855F7" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Inhaltsfläche: Glasscheibe mit abgerundeter Ecke zur Seitenleiste hin -->
                <Border Grid.Column="1" Grid.Row="1" CornerRadius="16,0,0,0" BorderBrush="#21FFFFFF" BorderThickness="1,1,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0FFFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Skin-Ebene -->

                <!-- Hintergrundlicht hinter dem Inhalt -->
                <Ellipse x:Name="Ambient" Grid.Column="1" Grid.RowSpan="2" Width="760" Height="760" IsHitTestVisible="False" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2A3B82F6" Offset="0"/>
                            <GradientStop Color="#146366F1" Offset="0.45"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Seitenleiste: schmale Symbolleiste, unter jedem Symbol sein Name -->
                <Border Grid.RowSpan="2" Background="#0C000000" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0">
                    <Grid Margin="10,0,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Kopf mit dem Zeichen des Programms; hier lässt sich das Fenster auch greifen -->
                        <Grid x:Name="NavHead" Background="Transparent" ToolTip="PulsRig">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGrad}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="66" Height="52">
                                        <Path Data="M 2,30 L 18,30 L 26,14 L 36,50 L 46,2 L 54,30 L 64,30" Stroke="{StaticResource OnAccent}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                            <Border x:Name="NavIndicator" Height="62" VerticalAlignment="Top" CornerRadius="12" Background="#14FFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="NavBar" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,18,0,0" CornerRadius="2" Background="{StaticResource AccentGrad}">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel>
                                <Grid x:Name="NavHome" Height="62" Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="Home">
                                    <Border CornerRadius="12" Background="White" Opacity="0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Scan" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                    <!-- nach einem Scan: Zahl der offenen Punkte -->
                                    <Border x:Name="NavHomeBadge" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="{StaticResource Bad}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform/>
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="NavHomeCount" Text="0" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Grid x:Name="NavBoost" Height="62" Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="Boost">
                                    <Border CornerRadius="12" Background="White" Opacity="0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Boost" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                    <!-- solange die Spiel-Beschleunigung eingeschaltet ist -->
                                    <Border x:Name="NavBoostOn" CornerRadius="6" Padding="5,1" Background="#2934D399" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="Collapsed">
                                        <TextBlock Text="AN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                                    </Border>
                                </Grid>
                                <Grid x:Name="NavTools" Height="62" Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="Tools">
                                    <Border CornerRadius="12" Background="White" Opacity="0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Werkzeuge" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="NavHardware" Height="62" Margin="0,0,0,6" Background="Transparent" Cursor="Hand" Tag="Hardware">
                                    <Border CornerRadius="12" Background="White" Opacity="0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Hardware" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid x:Name="NavSettings" Height="62" Background="Transparent" Cursor="Hand" ToolTip="Optionen">
                                <Border x:Name="NavSettingsHover" CornerRadius="12" Background="White" Opacity="0"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.72">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="Optionen" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </Grid>
                            <!-- das frühere Menü: seine Einträge stehen seit 17.10.2026 unter Optionen → Allgemein (Schnellzugriff) -->
                            <Grid x:Name="NavMenu" Height="62" Background="Transparent" Cursor="Hand" Visibility="Collapsed">
                                <Border x:Name="NavMenuHover" CornerRadius="12" Background="White" Opacity="0"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.72">
                                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="Menü" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Titelzeile -->
                <Grid x:Name="TitleBar" Grid.Column="1" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,8,0">
                        <!-- Adminrechte: kleines Schild; ohne Adminrechte mit Schaltfläche zum Neustart als Admin, das ganze Schild ist anklickbar -->
                        <Border x:Name="AdminBadge" CornerRadius="14" Padding="4,3,5,3" Background="#0D34D399" BorderBrush="#1F34D399" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Border x:Name="AdminIconBack" CornerRadius="10" Background="#2434D399"/>
                                    <TextBlock x:Name="AdminIcon" Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Good}"/>
                                </Grid>
                                <TextBlock x:Name="AdminText" Text="Adminrechte aktiv" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="7,0,7,0"/>
                                <TextBlock x:Name="AdminSub" Text="" Visibility="Collapsed"/>
                                <Border x:Name="AdminAction" CornerRadius="10" Padding="9,2,8,2" Background="#1FFBBF24" BorderBrush="#40FBBF24" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Als Admin neu starten" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Versionsschild: der Text kommt aus dem Programm -->
                        <Border CornerRadius="8" Padding="9,3" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
                            <TextBlock x:Name="TitleVersion" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                        </Border>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleButton}" Width="44" Height="32" Content="&#xE921;" Margin="0,0,2,0"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;"/>
                    </StackPanel>
                </Grid>
                <!-- Seiten -->
                <Grid x:Name="Pages" Grid.Column="1" Grid.Row="1" Margin="30,22,30,24">

                    <!-- Start: links der große Bereich mit dem SCAN-Knopf, rechts Live-Werte, Änderungen und Gaming-Check -->
                    <Grid x:Name="PageHome">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="286"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="24,18,24,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0" MinHeight="82">
                                        <!-- Gruß nach Tageszeit (PulsRig-Startseite.ps1) -->
                                        <TextBlock x:Name="HomeGreeting" Text="Hallo" FontSize="12.5" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Text="Scan" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="HintText" Text="Ein Klick auf SCAN sucht nach neueren Treibern." FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <!-- Problem zuerst: vom Problem zur Ursache (PulsRig-Problem.ps1) -->
                                    <Button x:Name="ChipProblem" Grid.Column="1" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,0,0" Height="34" Padding="12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Was ist los?" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Statusanzeige: Symbol und Randfarbe richten sich nach dem Zustand; nach einem Scan führt ein Klick zu den Ergebnissen -->
                                    <Grid x:Name="StatusPill" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent">
                                        <Border CornerRadius="19" Background="#0AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                                        <Border x:Name="StatusEdge" CornerRadius="19" BorderBrush="{StaticResource Accent}" BorderThickness="1" Opacity="0.45"/>
                                        <StackPanel Orientation="Horizontal" Margin="7,6,16,6">
                                            <Grid x:Name="StatusIcon" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Ellipse x:Name="StatusDot" Fill="{StaticResource Accent}" Opacity="0.18"/>
                                                <TextBlock x:Name="StatusGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock x:Name="StatusText" Text="Bereit für einen Scan" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusArrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,1,-4,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Hinweise oben im Bereich: Laufwerk auffällig (PulsRig-Verlauf.ps1), neuer Treiber macht Ärger (PulsRig-Probezeit.ps1) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,12,0,0" Panel.ZIndex="2">
                                    <Grid x:Name="DriveWarn" Visibility="Collapsed">
                                        <Border CornerRadius="14" Background="#F0161D2E" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                                        <Border CornerRadius="14" BorderBrush="{StaticResource Warn}" BorderThickness="1" Opacity="0.45"/>
                                        <Grid Margin="10,8,6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                <Ellipse Fill="{StaticResource Warn}" Opacity="0.16"/>
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,14,0">
                                                <TextBlock x:Name="DriveWarnTitle" Text="Ein Laufwerk ist auffällig" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DriveWarnText" Text="" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="DriveWarnOpen" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Ansehen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button x:Name="DriveWarnHide" Grid.Column="3" Style="{StaticResource TitleButton}" Content="&#xE8BB;" VerticalAlignment="Center" ToolTip="Ausblenden, bis sich etwas ändert"/>
                                        </Grid>
                                    </Grid>
                                    <Grid x:Name="ProbeWarn" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Border CornerRadius="14" Background="#F0161D2E" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                                        <Border CornerRadius="14" BorderBrush="{StaticResource Warn}" BorderThickness="1" Opacity="0.45"/>
                                        <Grid Margin="10,8,6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                <Ellipse Fill="{StaticResource Warn}" Opacity="0.16"/>
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,14,0">
                                                <TextBlock x:Name="ProbeWarnTitle" Text="Seit dem neuen Treiber mehr Abstürze" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="ProbeWarnText" Text="" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="ProbeWarnOpen" Grid.Column="2" Style="{StaticResource LinkButton}" Content="Zurückholen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button x:Name="ProbeWarnHide" Grid.Column="3" Style="{StaticResource TitleButton}" Content="&#xE8BB;" VerticalAlignment="Center" ToolTip="Ausblenden, bis sich etwas ändert"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <Grid x:Name="Orb" Grid.Row="1" Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform/>
                                    </Grid.RenderTransform>
                                    <!-- weicher Schein in den Ringfarben des Designs -->
                                    <Ellipse x:Name="OrbGlow" Width="330" Height="330" Opacity="0.5">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#33FB923C" Offset="0.42"/>
                                                <GradientStop Color="#14F43F5E" Offset="0.68"/>
                                                <GradientStop Color="#00F43F5E" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Schatten unter dem Knopf: ein Verlauf statt eines Weichzeichners, der kostet keine Rechenzeit -->
                                    <Ellipse Width="236" Height="236" IsHitTestVisible="False" Margin="0,14,0,0">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#99000000" Offset="0.72"/>
                                                <GradientStop Color="#33000000" Offset="0.86"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Ring-Animation: wird in PulsRig-Ringe.ps1 je nach gewähltem Stil aufgebaut -->
                                    <Canvas x:Name="RingLayer" Width="300" Height="300" IsHitTestVisible="False"/>
                                    <!-- Striche und Fortschrittsring bleiben ausgeblendet: beim Scan läuft nur die gewählte Ring-Animation -->
                                    <Canvas x:Name="OrbTicks" Width="300" Height="300" Opacity="0"/>
                                    <Ellipse x:Name="OrbProgress" Width="252" Height="252" StrokeThickness="5" Stroke="{StaticResource RingGrad}" StrokeDashArray="155.2 155.2" StrokeDashOffset="155.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="OrbDisc" Width="198" Height="198" Stroke="#2D3F6C" StrokeThickness="1.5">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.35,0.28">
                                                <GradientStop Color="#24345F" Offset="0"/>
                                                <GradientStop Color="#0E162D" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Glanz von oben und eine feine innere Kante: der Knopf wirkt gewölbt wie Glas -->
                                    <Ellipse Width="194" Height="194" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#24FFFFFF" Offset="0"/>
                                                <GradientStop Color="#08FFFFFF" Offset="0.32"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="188" Height="188" StrokeThickness="1" IsHitTestVisible="False">
                                        <Ellipse.Stroke>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                <GradientStop Color="#05FFFFFF" Offset="0.6"/>
                                                <GradientStop Color="#14FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Stroke>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,10">
                                        <!-- kleine Pulslinie über dem Wort: das Zeichen des Programms, in den Ringfarben -->
                                        <Viewbox x:Name="OrbIcon" Width="44" Height="26" HorizontalAlignment="Center" Margin="0,0,0,2">
                                            <Canvas Width="66" Height="52">
                                                <Path Data="M 2,30 L 18,30 L 26,14 L 36,50 L 46,2 L 54,30 L 64,30" Stroke="{StaticResource RingGrad}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="OrbLabel" Text="SCAN" FontSize="38" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OrbSub" Text="Treiber prüfen" FontSize="12.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Ellipse x:Name="OrbHit" Width="212" Height="212" Fill="Transparent" Cursor="Hand"/>
                                </Grid>

                                <!-- darunter läuft beim Scan der Name des gerade geprüften Geräts durch -->
                                <TextBlock x:Name="LastScanText" Grid.Row="2" Text="In dieser Sitzung wurde noch nicht gescannt" Foreground="{StaticResource TextFaint}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <!-- Schnellzugriffe: Ergebnisse des Scans und Spielkomponenten -->
                                <UniformGrid Grid.Row="3" Rows="1" Margin="-5,0,-5,0">
                                    <Button x:Name="ChipDrivers" Style="{StaticResource TileButton}" Width="Auto" Height="66" Margin="5,0" Cursor="Arrow">
                                        <Grid Margin="0,-3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="38" Height="38">
                                                <Border CornerRadius="11" Background="#2422D3EE"/>
                                                <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border x:Name="ChipDriversBadge" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Background="{StaticResource Bad}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform/>
                                                    </Border.RenderTransform>
                                                    <TextBlock x:Name="ChipDriversCount" Text="0" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="Gerätetreiber" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <!-- farbiger Punkt: Zustand nach dem letzten Scan -->
                                                    <Ellipse x:Name="HomeDriversDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,1,7,0" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="HomeDriversText" Text="Noch nicht geprüft" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock x:Name="HomeDriversArrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Visibility="Hidden"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ChipGames" Style="{StaticResource TileButton}" Width="Auto" Height="66" Margin="5,0">
                                        <Grid Margin="0,-3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="38" Height="38">
                                                <Border CornerRadius="11" Background="#24A855F7"/>
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border x:Name="ChipGamesBadge" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Background="{StaticResource Warn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform/>
                                                    </Border.RenderTransform>
                                                    <TextBlock x:Name="ChipGamesCount" Text="0" Foreground="#1A1300" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="Spielkomponenten" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <!-- farbiger Punkt: Zustand nach dem letzten Scan -->
                                                    <Ellipse x:Name="HomeGamesDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,1,7,0" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="HomeGamesText" Text="Noch nicht geprüft" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Live: drei Messwerte mit Kurve der letzten Minute (PulsRig-Startseite.ps1) -->
                            <Border x:Name="HomeLiveCard" Style="{StaticResource Card}" Padding="18,14,18,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HomeLiveDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                            <TextBlock Text="Live" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </StackPanel>
                                        <TextBlock Text="letzte Minute" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0" Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeLive0Label" Text="Grafikkarte" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeLive0Value" Text="–" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </StackPanel>
                                        <Grid x:Name="HomeLive0Area" Grid.Column="1" ClipToBounds="True" Margin="4,6,0,6">
                                            <Path x:Name="HomeLive0Line" Stroke="#22D3EE" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,6,0,0" Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeLive1Label" Text="Prozessor" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeLive1Value" Text="–" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </StackPanel>
                                        <Grid x:Name="HomeLive1Area" Grid.Column="1" ClipToBounds="True" Margin="4,6,0,6">
                                            <Path x:Name="HomeLive1Line" Stroke="#A855F7" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                    <Grid Margin="0,6,0,0" Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeLive2Label" Text="Arbeitsspeicher" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeLive2Value" Text="–" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </StackPanel>
                                        <Grid x:Name="HomeLive2Area" Grid.Column="1" ClipToBounds="True" Margin="4,6,0,6">
                                            <Path x:Name="HomeLive2Line" Stroke="{StaticResource Good}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Was hat sich geändert? Die neuesten Einträge als Zeitleiste (PulsRig-Aenderungen.ps1) -->
                            <Button x:Name="HomeHistory" Grid.Row="2" Style="{StaticResource TileButton}" Width="Auto" Height="Auto" Margin="0">
                                <Grid Margin="4,0,2,-2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Was hat sich geändert?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HomeChangesText" Grid.Row="1" Text="Ab heute mitgeschrieben" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <StackPanel x:Name="HomeChangesList" Grid.Row="2" ClipToBounds="True"/>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Ganzen Verlauf zeigen" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Gaming-Check: letzter Wert als kleiner Ring (PulsRig-Spielcheck.ps1) -->
                            <Button x:Name="HomeGameCheck" Grid.Row="4" Style="{StaticResource TileButton}" Width="Auto" Height="74" Margin="0">
                                <Grid Margin="2,-4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                                        <Ellipse Stroke="#1FFFFFFF" StrokeThickness="5"/>
                                        <Path x:Name="HomeGameArc" Stroke="{StaticResource AccentGrad}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="HomeGameScore" Text="–" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,8,0">
                                        <TextBlock Text="Gaming-Check" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        <TextBlock x:Name="HomeGameText" Text="Noch nicht geprüft" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                    <!-- Ergebnisse -->
                    <Grid x:Name="PageResults" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Width="52" Height="52" VerticalAlignment="Center">
                                <Border x:Name="ResultIconBack" CornerRadius="16" Background="#26FBBF24"/>
                                <TextBlock x:Name="ResultIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="ResultTitle" Text="Ergebnis" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ResultSub" Text="" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,12,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnResultsBack" Style="{StaticResource GhostButton}" Content="Zurück" Margin="0,0,10,0"/>
                                <Button x:Name="BtnUpdateAll" Style="{StaticResource PrimaryButton}" Content="Ausgewählte aktualisieren"/>
                            </StackPanel>
                            <!-- Übersicht in Zahlen und die Suche in der Liste -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <StackPanel x:Name="ResultChips" Orientation="Horizontal" VerticalAlignment="Center"/>
                                <Grid Width="230" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBox x:Name="ResultSearch" Style="{StaticResource Input}" Padding="22,0,0,0"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ResultSearchHint" Text="In der Liste suchen" FontSize="13" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ResultList" Margin="0,0,10,0"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Boost -->
                    <Grid x:Name="PageBoost" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,6,240,20">
                            <TextBlock Text="Boost" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="Schafft vor dem Spielen Platz: Energieplan, entbehrliche Dienste und speicherhungrige Programme." FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Gaming-Check (PulsRig-Spielcheck.ps1): zeigt den letzten Wert, ein Klick öffnet die Ampel-Liste -->
                        <Border x:Name="GameCheckPill" CornerRadius="17" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" Padding="14,7,16,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="GameCheckDot" Width="8" Height="8" Fill="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                <TextBlock x:Name="GameCheckText" Text="Gaming-Check" Foreground="{StaticResource Text}" FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Width="236" Height="236">
                                            <Ellipse x:Name="GaugeGlow" Width="236" Height="236" Opacity="0">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#2A22D3EE" Offset="0.5"/>
                                                        <GradientStop Color="#00000000" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="210" Height="210" StrokeThickness="8" Stroke="#1C2848" StrokeDashArray="59.5 79.33" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="135"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="GaugeValue" Width="210" Height="210" StrokeThickness="8" Stroke="{StaticResource AccentGrad}" StrokeDashArray="59.5 79.33" StrokeDashOffset="59.5" StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="135"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Canvas x:Name="GaugeTicks" Width="210" Height="210"/>
                                            <Grid x:Name="GaugeNeedle" Width="210" Height="210" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <RotateTransform Angle="-135"/>
                                                </Grid.RenderTransform>
                                                <Rectangle x:Name="GaugeHand" Width="4" Height="66" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Top" Margin="0,42,0,0">
                                                    <Rectangle.RenderTransform>
                                                        <RotateTransform CenterX="2" CenterY="63"/>
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Grid>
                                            <Ellipse Width="26" Height="26" Fill="#0E162D" Stroke="#4A5F96" StrokeThickness="2"/>
                                            <TextBlock x:Name="GaugeState" Text="AUS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <ScaleTransform/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="Spiel-Beschleunigung" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="BoostInfo" Text="Derzeit ausgeschaltet" FontSize="12.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <!-- was der Boost anfasst bzw. angefasst hat, als kleine Schilder -->
                                        <WrapPanel x:Name="BoostChips" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,2">
                                        <Button x:Name="BtnBoostSetup" Style="{StaticResource GhostButton}" Content="Einrichten" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnBoost" Style="{StaticResource PrimaryButton}" Content="Einschalten" MinWidth="170"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Arbeitsspeicher" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock x:Name="RamInfo" Text="" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,4,0,0"/>
                                    <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- neben dem Ring: belegt und frei in Zahlen -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Border CornerRadius="12" Padding="14,10" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGrad}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="BELEGT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="RamUsed" Text="– GB" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="12" Padding="14,10" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Margin="0,8,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="#33466F" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="FREI" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="RamFree" Text="– GB" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Grid Width="178" Height="178" HorizontalAlignment="Left">
                                        <Ellipse Width="170" Height="170" StrokeThickness="9" Stroke="#1C2848"/>
                                        <Ellipse x:Name="RamRing" Width="170" Height="170" StrokeThickness="9" Stroke="{StaticResource AccentGrad}" StrokeDashArray="56.2 56.2" StrokeDashOffset="56.2" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <!-- Lichtpunkt an der Spitze des Bogens; dreht mit dem Stand mit -->
                                        <Grid x:Name="RamTip" Width="170" Height="170" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform/>
                                            </Grid.RenderTransform>
                                            <Ellipse Width="26" Height="26" VerticalAlignment="Top" Margin="0,-8.5,0,0">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#9922D3EE" Offset="0"/>
                                                        <GradientStop Color="#0022D3EE" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Width="5" Height="5" Fill="White" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="RamPercent" Text="0 %" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="belegt" FontSize="12" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                    <TextBlock Text="GRÖSSTE VERBRAUCHER" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="0,22,0,12"/>
                                    <StackPanel x:Name="RamList"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Werkzeuge -->
                    <Grid x:Name="PageTools" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,2,0,14">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Werkzeuge" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="Jedes Werkzeug prüft zuerst nur und fragt nach, bevor es etwas verändert." FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- Suche: blendet beim Tippen alle Werkzeuge aus, die nicht passen -->
                            <Grid Width="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0">
                                <TextBox x:Name="ToolSearch" Style="{StaticResource Input}" Padding="22,0,0,0"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="ToolSearchHint" Text="Werkzeug suchen" FontSize="13" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <WrapPanel x:Name="ToolGrid"/>
                                <TextBlock x:Name="ToolSearchNone" Text="Kein Werkzeug passt zu dieser Suche." FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Hardware: Karten der geplanten Bereiche; welche schon eine Funktion haben, legt PulsRig-Hardware.ps1 fest -->
                    <Grid x:Name="PageHardware" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,6,0,18">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="Hardware" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="Sensoren, Tests und Zustand der Bauteile an einem Ort." FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                                <!-- Monitor-Test (PulsRig-Monitor.ps1) -->
                                <Border x:Name="HardwareMonitorPill" CornerRadius="17" Background="#0AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        <TextBlock Text="Monitor-Test" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                    </StackPanel>
                                </Border>
                                <!-- Akku-Bericht: nur auf Notebooks sichtbar (PulsRig-Akku.ps1) -->
                                <Border x:Name="HardwareBatteryPill" CornerRadius="17" Background="#0AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HardwareBatteryGlyph" Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        <TextBlock x:Name="HardwareBatteryText" Text="Akku" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                    </StackPanel>
                                </Border>
                                <!-- Benchmark mit dem letzten Wert (PulsRig-Benchmark.ps1) -->
                                <Border x:Name="HardwareBenchPill" CornerRadius="17" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" Padding="14,7,16,7" Margin="0,0,10,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        <TextBlock x:Name="HardwareBenchText" Text="Benchmark" Foreground="{StaticResource Text}" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- deutlicher Hinweis: die Seite ist im Aufbau; der Text kommt aus PulsRig-Hardware.ps1 -->
                                <Border x:Name="HardwarePill" CornerRadius="17" Background="#12FBBF24" BorderBrush="#33FBBF24" BorderThickness="1" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HardwarePillDot" Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                        <TextBlock Text="Vorschau – noch ohne Funktion" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <UniformGrid x:Name="HardwareGrid" Grid.Row="1" Columns="4" Rows="2" Margin="0,0,-12,-12">
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#2422D3EE"/>
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Sensoren" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Temperaturen, Lüfter und Auslastung live" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Height="32" Margin="0,3,0,0"/>
                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Grafikkarte, Lüfter" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Prozessor: Last, Takt" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Verlauf über 1 Minute" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#24FB923C"/>
                                            <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FB923C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Stabilitätstest" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Prozessor und Grafikkarte unter Volllast" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Height="32" Margin="0,3,0,0"/>
                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#FB923C" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Prozessor-Volllast" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#FB923C" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Grafik-Volllast" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#FB923C" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Stopp bei Fehlern" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#24A855F7"/>
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Laufwerke" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Zustand, Belegung, Tempo und Verlauf" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Height="32" Margin="0,3,0,0"/>
                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Zustand, Störungen" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Tempo und Verlauf" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Betriebsstunden" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#24F43F5E"/>
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Arbeitsspeicher" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
