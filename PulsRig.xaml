                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#24A855F7"/>
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Bildschirm" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Bildwiederholrate und Testbilder im Vollbild" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Height="32" Margin="0,3,0,0"/>
                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Hz prüfen" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Acht Testbilder" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#A855F7" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Pixelfehler finden" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#2422D3EE"/>
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Bericht &amp; Diagnose" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
