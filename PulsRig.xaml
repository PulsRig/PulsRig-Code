                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Alle Prüfergebnisse" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Angaben zum PC" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Eine ZIP-Datei" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,12" Margin="0,0,12,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#2460A5FA"/>
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="In Arbeit" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="BIOS" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,12,0,0"/>
                                    <TextBlock Text="Version, Alter und Seite des Herstellers" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Height="32" Margin="0,3,0,0"/>
                                    <Border Height="1" Background="#14FFFFFF" Margin="0,11,0,9"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#60A5FA" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Version und Datum" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#60A5FA" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Alter in Worten" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="5" Height="5" Fill="#60A5FA" VerticalAlignment="Center" Margin="2,1,10,0"/>
                                        <TextBlock Text="Link zum Hersteller" FontSize="12" Foreground="{StaticResource Text}" Opacity="0.82" TextWrapping="Wrap" MaxWidth="140"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- Seitenmenü: gleitet von links herein -->
                <Grid x:Name="Drawer" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <Border x:Name="DrawerDim" Background="#A6060A14" Opacity="0" CornerRadius="18"/>
                    <Border x:Name="DrawerCard" Width="304" HorizontalAlignment="Left" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0" CornerRadius="18,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                <GradientStop Color="#13203F" Offset="0"/>
                                <GradientStop Color="#0C1326" Offset="0.55"/>
                                <GradientStop Color="#0B1122" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform X="-304"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Kopf: Logo und Titel, rechts der Knopf zum Schließen -->
                            <Grid x:Name="DrawerHead" Margin="20,18,10,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                                        <Grid Width="132" Height="132">
                                            <Ellipse Width="120" Height="120" StrokeThickness="8" Stroke="{StaticResource AccentGrad}"/>
                                            <Path Data="M 34,68 L 50,68 L 58,52 L 68,88 L 78,40 L 86,68 L 96,68" Stroke="White" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            <Path Data="M 101,68 A 5,5 0 1 1 111,68 A 5,5 0 1 1 101,68 Z" Fill="#22D3EE"/>
                                        </Grid>
                                    </Viewbox>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Menü" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Verlauf, Ordner, Design und Hilfe" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="BtnDrawerClose" Style="{StaticResource TitleButton}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="12,8,12,0">
                                <TextBlock x:Name="DrawerLabel" Text="SCHNELLZUGRIFF" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="8,4,0,6"/>
                                <StackPanel x:Name="DrawerItems"/>
                            </StackPanel>
                            <!-- unten im Menü: welche Fassung läuft (der Text kommt aus PulsRig-Ansichten.ps1) -->
                            <TextBlock x:Name="DrawerFoot" Grid.Row="2" Margin="22,0,20,20" FontSize="11.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Großer Dialog mit Reitern: Einstellungen, Boost-Auswahl, Spielkomponenten, Systeminformationen -->
                <Grid x:Name="Sheet" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <Border x:Name="SheetDim" Background="#C2060A14" Opacity="0" CornerRadius="18"/>
                    <Border x:Name="SheetCard" Width="920" Height="616" CornerRadius="18" Background="#101930" BorderBrush="#2A3A63" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="22,18,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="42" Height="42">
                                    <Border CornerRadius="13" Background="#2422D3EE" BorderBrush="#3322D3EE" BorderThickness="1"/>
                                    <TextBlock x:Name="SheetGlyph" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SheetTitle" Text="" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock x:Name="SheetSub" Text="" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Grid x:Name="SheetSearchBox" Grid.Column="2" Width="200" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBox x:Name="SheetSearch" Style="{StaticResource Input}" Padding="22,0,0,0"/>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SheetSearchHint" Text="Suchen" FontSize="13" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="BtnSheetClose" Grid.Column="3" Style="{StaticResource TitleButton}" Content="&#xE8BB;" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid x:Name="SheetTabRow" Grid.Row="1" Margin="26,2,22,12" HorizontalAlignment="Left">
                                <Border CornerRadius="12" Background="{StaticResource Glass}" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="-4,-4,-0,-4"/>
                                <Border x:Name="SheetTabMark" Height="32" Width="60" HorizontalAlignment="Left" CornerRadius="10" Background="{StaticResource AccentGrad}" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="SheetTabs" Orientation="Horizontal"/>
                            </Grid>
                            <!-- Übersicht in Zahlen rechts neben den Reitern -->
                            <StackPanel x:Name="SheetChips" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,14,12"/>

                            <Grid Grid.Row="2" Margin="10,0,12,0">
                                <ListBox x:Name="SheetList" Style="{StaticResource SheetListStyle}" ItemContainerStyle="{StaticResource SheetItem}" ItemTemplate="{StaticResource SheetRow}"/>
                                <ScrollViewer x:Name="SheetScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="12,0,0,0">
                                    <StackPanel x:Name="SheetPanel" Margin="0,0,14,0"/>
                                </ScrollViewer>
                                <StackPanel x:Name="SheetLoader" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Grid Width="56" Height="56">
                                        <Ellipse StrokeThickness="4" Stroke="#1C2848"/>
                                        <Ellipse x:Name="SheetSpinner" StrokeThickness="4" Stroke="{StaticResource AccentGrad}" StrokeDashArray="10 31" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="SheetLoaderText" Text="Laden …" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Verlaufskurve für Prozessor und Arbeitsspeicher -->
                            <Border x:Name="SheetChart" Grid.Row="3" Margin="22,10,22,0" Padding="16,12" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ChartLabel" Text="AUSLASTUNG" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>
                                        <TextBlock x:Name="ChartValue" Text="– %" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,2,0,0"/>
                                        <TextBlock Text="letzte 60 Sekunden" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                                    </StackPanel>
                                    <Grid x:Name="ChartArea" Grid.Column="1" Height="74" ClipToBounds="True">
                                        <Path x:Name="ChartFill" Opacity="0.22" Fill="{StaticResource AccentGrad}"/>
                                        <Path x:Name="ChartLine" Stroke="{StaticResource AccentGrad}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="ChartDot" Width="9" Height="9" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4.5,-4.5,0,0" Opacity="0">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Height="1" VerticalAlignment="Top" Background="#14FFFFFF" Margin="0,8,0,0"/>
                            <Grid Grid.Row="4" Margin="22,22,22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSheetLink" Style="{StaticResource LinkButton}" Content="" VerticalAlignment="Center" Margin="-4,0,0,0"/>
                                <TextBlock x:Name="SheetState" Grid.Column="1" Text="" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnSheetSecondary" Style="{StaticResource GhostButton}" Content="Schließen"/>
                                    <Button x:Name="BtnSheetPrimary" Style="{StaticResource PrimaryButton}" Content="OK" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dialog über allem: Werkzeuglauf, Aktualisierung -->
                <Grid x:Name="Overlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <Border x:Name="OverlayDim" Background="#C2060A14" Opacity="0"/>
                    <Border x:Name="DialogCard" Width="680" Height="520" CornerRadius="18" Background="#101930" BorderBrush="#2A3A63" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="22,18,14,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- ohne Adminrechte: Schild "Probelauf" neben dem Schließen-Knopf -->
                                <Border x:Name="DialogBadge" Grid.Column="2" CornerRadius="8" Padding="9,4" Background="#12FBBF24" BorderBrush="#33FBBF24" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock Text="Probelauf" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
                                </Border>
                                <Grid Width="42" Height="42">
                                    <Border CornerRadius="13" Background="#2422D3EE" BorderBrush="#3322D3EE" BorderThickness="1"/>
                                    <TextBlock x:Name="DialogGlyph" Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DialogTitle" Text="Werkzeug" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock x:Name="DialogSub" Text="" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="BtnDialogClose" Grid.Column="3" Style="{StaticResource TitleButton}" Content="&#xE8BB;" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- Laufbalken -->
                            <Grid Grid.Row="1" Background="#18223F" ClipToBounds="True">
                                <Border x:Name="DialogBar" Width="200" HorizontalAlignment="Left" Background="{StaticResource AccentGrad}" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-200"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <!-- die Ausgabe des Werkzeugs steht in einem eigenen Feld -->
                                <Border x:Name="LogFrame" Margin="22,14,22,8" CornerRadius="14" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Opacity="0">
                                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,12,6,12">
                                        <StackPanel x:Name="LogPanel" Margin="0,0,12,0"/>
                                    </ScrollViewer>
                                </Border>
                                <!-- Einstieg, solange das Werkzeug noch nicht läuft -->
                                <Grid x:Name="DialogIntro" Margin="28,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                                            <Ellipse x:Name="DialogIntroHalo">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#4022D3EE" Offset="0"/>
                                                        <GradientStop Color="#146366F1" Offset="0.6"/>
                                                        <GradientStop Color="#006366F1" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Border Width="62" Height="62" CornerRadius="20" Background="#2422D3EE" BorderBrush="#4D22D3EE" BorderThickness="1"/>
                                            <TextBlock x:Name="DialogIntroGlyph" Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="DialogIntroText" Text="" FontSize="14.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                        <!-- Überblick in Karten, zum Beispiel was der Boost anfasst -->
                                        <UniformGrid x:Name="DialogIntroCards" Rows="1" Margin="-5,18,-5,0" Visibility="Collapsed"/>
                                        <Border x:Name="DialogIntroNote" Margin="0,14,0,0" CornerRadius="12" Padding="14,10" Background="{StaticResource Glass}" BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                <TextBlock x:Name="DialogIntroNoteText" Grid.Column="1" Text="" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" MaxWidth="540"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Rückfrage des Werkzeugs -->
                            <Border x:Name="PromptPanel" Grid.Row="3" Margin="22,2,22,12" CornerRadius="14" Background="#1422D3EE" BorderBrush="#5922D3EE" BorderThickness="1" Padding="14,13,16,13" Visibility="Collapsed" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="12"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- der Rand pulsiert sanft, solange das Werkzeug auf die Antwort wartet -->
                                    <Border x:Name="PromptGlow" Grid.ColumnSpan="3" Margin="-15,-14,-17,-14" CornerRadius="14" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"/>
                                    <Grid Width="38" Height="38" VerticalAlignment="Top" Margin="0,1,13,0">
                                        <Border CornerRadius="11" Background="#2422D3EE"/>
                                        <TextBlock x:Name="PromptGlyph" Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PromptLabel" Text="DEINE ENTSCHEIDUNG" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="PromptText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                        <TextBox x:Name="PromptInput" Style="{StaticResource Input}" Margin="0,9,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="PromptHint" Text="" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
                                        <Button x:Name="BtnPromptNo" Style="{StaticResource GhostButton}" Content="Nein" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnPromptYes" Style="{StaticResource PrimaryButton}" Content="Ja" Padding="20,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Margin="22,4,22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Erfolgshaken: Kreis poppt auf, Haken zeichnet sich -->
                                <Grid x:Name="DoneMark" Width="34" Height="34" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="DoneCircle" Fill="#2634D399" Stroke="#34D399" StrokeThickness="1.5"/>
                                    <Path x:Name="DoneCheck" Data="M 10,17.5 L 15,22.5 L 24.5,12" Stroke="#34D399" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="9 9" StrokeDashOffset="9"/>
                                </Grid>
                                <TextBlock x:Name="DialogState" Grid.Column="1" Text="" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="BtnDialogSecondary" Style="{StaticResource GhostButton}" Content="Schließen" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnDialogStart" Style="{StaticResource PrimaryButton}" Content="Starten"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Vorspann -->
                <Grid x:Name="Splash" Grid.ColumnSpan="2" Grid.RowSpan="2">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0C1326" Offset="0"/>
                            <GradientStop Color="#090D1A" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Ellipse x:Name="SplashGlow" Width="620" Height="620" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5022D3EE" Offset="0"/>
                                <GradientStop Color="#286366F1" Offset="0.4"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid x:Name="SplashMark" Width="132" Height="132" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <!-- die Pulslinie läuft nach dem ersten Schlag links und rechts aus dem Ring hinaus und verblasst -->
                            <Canvas Width="132" Height="132">
                                <Rectangle x:Name="SplashLineL" Canvas.Left="-314" Canvas.Top="66.5" Width="320" Height="3" RadiusX="1.5" RadiusY="1.5" Opacity="0" RenderTransformOrigin="1,0.5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0022D3EE" Offset="0"/>
                                            <GradientStop Color="#B322D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="SplashLineR" Canvas.Left="126" Canvas.Top="66.5" Width="320" Height="3" RadiusX="1.5" RadiusY="1.5" Opacity="0" RenderTransformOrigin="0,0.5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#B3A855F7" Offset="0"/>
                                            <GradientStop Color="#00A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                            <Ellipse x:Name="SplashRing" Width="120" Height="120" StrokeThickness="5" Stroke="{StaticResource AccentGrad}" StrokeDashArray="72.3 72.3" StrokeDashOffset="72.3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Pulslinie: zeichnet sich von links nach rechts, am Ende poppt der Punkt auf -->
                            <Path x:Name="SplashPulse" Data="M 34,68 L 50,68 L 58,52 L 68,88 L 78,40 L 86,68 L 96,68" Stroke="White" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="28 28" StrokeDashOffset="28" Opacity="0"/>
                            <Path x:Name="SplashDot" Data="M 101,68 A 5,5 0 1 1 111,68 A 5,5 0 1 1 101,68 Z" Fill="#22D3EE" Opacity="0">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0.1" ScaleY="0.1" CenterX="106" CenterY="68"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <StackPanel x:Name="SplashWord" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Opacity="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="16"/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="Puls" FontSize="38" FontWeight="Light" Foreground="#E8EEFC"/>
                            <TextBlock Text="Rig" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource AccentGrad}"/>
                        </StackPanel>
                        <StackPanel x:Name="SplashTag" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Treiber." FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,0,5,0" Opacity="0"/>
                            <TextBlock Text="Boost." FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,0,5,0" Opacity="0"/>
                            <TextBlock Text="Werkzeuge." FontSize="14" Foreground="{StaticResource TextDim}" Opacity="0"/>
                        </StackPanel>
                        <Grid Width="180" Height="3" Margin="0,34,0,0" ClipToBounds="True" x:Name="SplashTrack" Opacity="0">
                            <Border Background="#18223F" CornerRadius="1.5"/>
                            <Border x:Name="SplashBar" Width="70" HorizontalAlignment="Left" Background="{StaticResource AccentGrad}" CornerRadius="1.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-70"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="SplashVersion" Text="" FontSize="12" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Opacity="0"/>
                </Grid>

                <!-- Beim Designwechsel liegt kurz ein Bild des alten Aussehens obenauf und blendet aus -->
                <Image x:Name="ThemeFade" Grid.ColumnSpan="2" Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Aufklappmenü einer Ergebniszeile -->
                <Popup x:Name="RowMenu" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" HorizontalOffset="-252" PopupAnimation="None">
                    <!-- klappt aus der Ecke am Knopf mit den drei Punkten auf -->
                    <Border x:Name="RowMenuCard" Margin="12" CornerRadius="14" BorderBrush="#33466F" BorderThickness="1" Padding="6" RenderTransformOrigin="0.95,0">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="#1B294F" Offset="0"/>
                                <GradientStop Color="#131C38" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Width="260">
                            <!-- oben steht, zu welchem Eintrag das Menü gehört -->
                            <TextBlock x:Name="RowMenuTitle" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" Margin="10,7,10,8"/>
                            <Border Height="1" Background="#14FFFFFF" Margin="4,0,4,5"/>
                            <StackPanel x:Name="RowMenuItems"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
