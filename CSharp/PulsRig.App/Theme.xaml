<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reihe Q („Nacht-Bento“, Lila-Nacht). Farben und Maße wie im Entwurf -->
    <FontFamily x:Key="Sans">Sora, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <Color x:Key="LilaDunkel">#6D43C9</Color>
    <Color x:Key="Beere">#A8326F</Color>
    <SolidColorBrush x:Key="Text" Color="#E2DCEB"/>
    <SolidColorBrush x:Key="Leise" Color="#8C819F"/>
    <SolidColorBrush x:Key="Halbleise" Color="#B3A8C4"/>
    <SolidColorBrush x:Key="Lila" Color="#8C6BD6"/>
    <SolidColorBrush x:Key="LilaHell" Color="#B19FE0"/>
    <SolidColorBrush x:Key="Rose" Color="#C0608F"/>
    <SolidColorBrush x:Key="Gruen" Color="#5EE0A0"/>
    <SolidColorBrush x:Key="Bernstein" Color="#F2B661"/>
    <SolidColorBrush x:Key="Indigo" Color="#5E4BB8"/>
    <SolidColorBrush x:Key="Karte" Color="#0B0710"/>
    <SolidColorBrush x:Key="KarteRand" Color="#22172F"/>
    <SolidColorBrush x:Key="Trenner" Color="#3E3150"/>

    <LinearGradientBrush x:Key="Puls" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6D43C9"/>
        <GradientStop Offset="1" Color="#A8326F"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PulsQuer" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#6D43C9"/>
        <GradientStop Offset="1" Color="#A8326F"/>
    </LinearGradientBrush>

    <!-- Grund: zwei weiche Lichtflecken auf fast Schwarz -->
    <DrawingBrush x:Key="Grund" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#040207" Geometry="M0,0 H1100 V720 H0 Z"/>
                <GeometryDrawing Geometry="M0,0 H1100 V720 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.3,0.4" GradientOrigin="0.3,0.4" RadiusX="0.64" RadiusY="0.58">
                            <GradientStop Offset="0" Color="#126D43C9"/>
                            <GradientStop Offset="0.7" Color="#006D43C9"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1100 V720 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.47" RadiusY="0.53">
                            <GradientStop Offset="0" Color="#12A8326F"/>
                            <GradientStop Offset="0.7" Color="#00A8326F"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Knöpfe ohne Windows-Rahmen: nur Inhalt, Hintergrund vom Knopf -->
    <Style x:Key="Flach" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=0}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kachel (.p-tile); den Transform nutzt der Scan der Startseite (HomePage.Scan) -->
    <Style x:Key="Kachel" TargetType="Border">
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup>
            </Setter.Value>
        </Setter>
        <!-- kein Schatten (DropShadowEffect): WPF zeichnet sonst die ganze Kachel samt Schrift über ein Zwischenbild,
             das macht den Text weich und kostet bei jeder Animation Leistung.
             Kein Anheben beim Überfahren mehr (26.10.2026): Seiten mit Live-Werten bauen ihre Kacheln laufend neu, jede
             neue Kachel unter der Maus hob sich wieder an - die Kacheln sprangen auf und ab. -->
    </Style>

    <Style x:Key="KachelKopf" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ZahlGross" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- blinkender Punkt (.p-blink) -->
    <Storyboard x:Key="Blinken" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.35"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
            <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
</ResourceDictionary>
