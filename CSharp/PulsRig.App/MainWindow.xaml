<Window x:Class="PulsRig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulsRig" Icon="PulsRig.ico" Width="1100" Height="720" MinWidth="980" MinHeight="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource Sans}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <ScrollViewer x:Name="Surface" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False"><Border x:Name="Shell" CornerRadius="16" Background="{StaticResource Grund}" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Leiste links -->
            <Border Background="#030205" BorderBrush="#130D1B" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16">
                <DockPanel Margin="0,18" LastChildFill="False">
                    <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="12" Margin="0,0,0,18"
                            Background="{StaticResource Puls}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#6D43C9" Opacity="0.25"/>
                        </Border.Effect>
                        <Path Data="M3 12h4l2-5 4 10 2-5h6" Stroke="#08030E" StrokeThickness="2.4" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,-2,0,0"/>
                    </Border>
                    <StackPanel x:Name="Rail" DockPanel.Dock="Top"/>
                    <StackPanel x:Name="RailBottom" DockPanel.Dock="Bottom"/>
                </DockPanel>
            </Border>

            <!-- Inhalt -->
            <Grid Grid.Column="1" Margin="44,14,44,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Titelzeile: Zurück, Weg-Leiste, Zustand, Fensterknöpfe -->
                <DockPanel x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- neue Fassung bei GitHub (Neuefassung.cs): erscheint nur, wenn es eine gibt -->
                        <!-- soll gleich auffallen: gefüllter Knopf im Puls-Verlauf mit leicht runden Ecken (kein Oval), Pfeil nach unten;
                             beim Überfahren etwas heller -->
                        <Border x:Name="VersionChip" Visibility="Collapsed" Margin="0,0,20,0" Padding="11,5,13,5" CornerRadius="8" Background="{StaticResource PulsQuer}"
                                Cursor="Hand" MouseLeftButtonUp="Version_Click" ToolTip="Neue Fassung laden und installieren">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.92"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↓" FontSize="12.5" FontWeight="Bold" Foreground="#06101C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold" Foreground="#06101C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Ellipse x:Name="WatchDot" Width="7" Height="7" Fill="{StaticResource Gruen}" Margin="0,0,8,0">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#5EE0A0"/></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="WatchText" Text="Überwachung läuft" FontSize="12" Foreground="{StaticResource Leise}" VerticalAlignment="Center"/>
                        <!-- ohne Adminrechte: Schild, Hinweis und ein dezenter Knopf zum Neustart als Administrator -->
                        <StackPanel x:Name="AdminChip" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Path Data="M12 2 L20 5 V11 C20 16 16.5 20 12 22 C7.5 20 4 16 4 11 V5 Z" Fill="#33E3B341" Stroke="#E3B341" StrokeThickness="1.6"
                                  Stretch="Uniform" Width="13" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Ohne Adminrechte" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="10,3,8,4" CornerRadius="8" Background="#14E3B341" BorderBrush="#40E3B341" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Als Administrator neu starten" MouseLeftButtonUp="Admin_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Als Admin neu starten" FontSize="12" Foreground="#E3CD95" VerticalAlignment="Center"/>
                                    <TextBlock Text="›" FontSize="13" Foreground="#E3B341" Margin="6,-1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource Flach}" Width="32" Height="28" Margin="8,0,0,0" Foreground="{StaticResource Leise}"
                                Click="Minimize_Click" ToolTip="Minimieren" AutomationProperties.Name="Minimieren">
                            <TextBlock Text="–" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource Flach}" Width="32" Height="28" Foreground="{StaticResource Leise}"
                                Click="Close_Click" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                            <TextBlock Text="✕" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Left" x:Name="BackButton" Style="{StaticResource Flach}" Height="34" Padding="10,0,14,0" Tag="17"
                                Background="{StaticResource Karte}" BorderBrush="{StaticResource KarteRand}" BorderThickness="1"
                                Margin="0,0,8,0" Click="Back_Click" ToolTip="Eine Ebene zurück" AutomationProperties.Name="Zurück" Visibility="Collapsed">
                            <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M15 18l-6-6 6-6" Stroke="{StaticResource Text}" StrokeThickness="2.2" Width="15" Height="15"
                                      Stretch="Uniform" Margin="0,0,6,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="Zurück" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <WrapPanel x:Name="Crumbs" VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,24,0,0" Focusable="False"
                                RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</ScrollViewer></Window>
